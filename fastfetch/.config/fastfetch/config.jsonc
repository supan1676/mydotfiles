{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "arch",
        "padding": { "bottom": 1 },
        "color": {
            "1": "38;2;255;255;255",
            "2": "38;2;210;210;210",
            "3": "38;2;165;165;165",
            "4": "38;2;120;120;120"
        }
    },
    "display": {
        "separator": " ",
        "color": {
            "keys": "38;2;255;255;255",
            "output": "38;2;165;165;165"
        }
    },
    "modules": [
        { "key": "╭───────────╮", "type": "custom" },
        { "key": "│  user    │", "type": "title", "format": "{user-name}" },
        { "key": "│ 󰇅 hname   │", "type": "title", "format": "{host-name}" },
        { "key": "│ 󰅐 uptime  │", "type": "uptime" },
        { "key": "│  distro  │", "type": "os" },
        { "key": "│  kernel  │", "type": "kernel" },
        { "key": "│  wm      │", "type": "wm" },
        { "key": "│  term    │", "type": "terminal" },
        { "key": "│  shell   │", "type": "shell" },
        { "key": "│ 󰍛 cpu     │", "type": "cpu", "showPeCoreCount": true },
        { "key": "│ 󰉉 disk    │", "type": "disk", "folders": "/" },
        { "key": "│  memory  │", "type": "memory" },
        { "key": "├───────────┤", "type": "custom" },
        { "key": "│ PC        │", "type": "host", "format": "{5} {1} ({2})" },
        { "key": "│ ├ 󰢮 gpu   │", "type": "gpu", "format": "{1} {2} @ {12}" },
        { "key": "│ ├ 󰓡 swap  │", "type": "swap" },
        { "key": "│ ├  disp  │", "type": "monitor", "format": "{1} px @ {2} Hz - {3} mm ({4} inches, {5} pp)" },
        { "key": "│ └  dtime │", "type": "command", "text": "birth_install=$(stat -c %W / 2>/dev/null || echo 0); [ \"$birth_install\" -le 0 ] 2>/dev/null && birth_install=$(stat -c %Y /var/log 2>/dev/null || date +%s); current=$(date +%s); echo $(( (current - birth_install) / 86400 )) days" },
        { "key": "│  colors  │", "type": "colors", "symbol": "circle" },
        { "key": "╰───────────╯", "type": "custom" }
    ]
}
