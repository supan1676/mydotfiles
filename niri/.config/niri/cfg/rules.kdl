// ── Active appearance phase: PERSONAL (Phase 2) ──────────────
// This file is the live Niri rules file. `toggle-phase.sh` replaces it
// with either rules-personal.kdl or rules-repo-default.kdl.
// Global opacity 0.75 | blur passes 2, offset 3.0, noise 0.03,
// saturation 1.0 | corner radius 20.
//
// Niri 26.04 syntax: the top-level `blur` block may appear only once.

// ── Global Blur Settings (Personal Preferences) ──────────────
blur {
    passes 2        // stronger blur with more passes; default is 3
    offset 3.0      // sample distance per pass
    noise 0.03      // grain overlay
    saturation 1.0  // color saturation of the blurred background
}

// ── Global Window Rules ──────────────────────────────────────
window-rule {
    geometry-corner-radius 20 // Window corner radius: 20
    clip-to-geometry true
    draw-border-with-background false
}

// Global opacity and blur (Phase 2: personal preference, 0.75)
window-rule {
    opacity 0.75
    background-effect {
        blur true
        xray true
    }
}

// ── Noctalia Settings Window ─────────────────────────────────
window-rule {
    match app-id="dev.noctalia.Noctalia"
    open-floating true
    default-column-width { fixed 1080; }
    default-window-height { fixed 850; }
}

// ── Steam Rules ──────────────────────────────────────────────
window-rule {
    match app-id="steam"
    exclude title=r"^[Ss]team$"
    open-floating true
}

window-rule {
    match app-id="steam" title=r"^notificationtoasts_\d+_desktop$"
    default-floating-position x=10 y=10 relative-to="bottom-right"
    open-focused false
}

// ── Noctalia Layer Rules ─────────────────────────────────────
layer-rule {
    match namespace="^noctalia-wallpaper"
    place-within-backdrop true
}

layer-rule {
    match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd)$"
    background-effect {
        blur true
        xray false
    }
}

layer-rule {
    match namespace="noctalia-window-switcher"
    background-effect {
        blur true
        xray false
    }
}

// ── App Specific Rules (Personal Preferences) ─────────────────
// Firefox: opacity 0.75, blur enabled
window-rule {
    match app-id="firefox"
    opacity 0.75
    background-effect {
        blur true
        xray true
    }
}

// Discord: opacity 0.73, blur disabled
window-rule {
    match app-id="discord"
    opacity 0.73
    background-effect {
        blur false
        xray false
    }
}

// Nautilus: opacity 0.65, blur enabled
window-rule {
    match app-id="org.gnome.Nautilus"
    opacity 0.65
    background-effect {
        blur true
        xray true
    }
}

// ── Exceptions (mpv and VLC opacity: 1.0) ────────────────────
window-rule {
    match app-id="mpv"
    match app-id="vlc"
    opacity 1.0
}
